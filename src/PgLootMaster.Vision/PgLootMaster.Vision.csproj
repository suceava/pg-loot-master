<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260427" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260302" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed every panel-title*.png template into the assembly so PanelLocator can load
         them from manifest resources at runtime — no on-disk Templates\ folder required.
         Lets the app ship as a single self-contained .exe. Drop a new file (e.g.
         panel-title-cashfall.png) into samples/templates/ to add a variant.
         LogicalName picks the resource id PanelLocator looks up. -->
    <EmbeddedResource Include="..\..\samples\templates\panel-title*.png"
                      LogicalName="PgLootMaster.Vision.Templates.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
