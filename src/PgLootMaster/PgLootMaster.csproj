<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PgLootMaster.Capture\PgLootMaster.Capture.csproj" />
    <ProjectReference Include="..\PgLootMaster.Vision\PgLootMaster.Vision.csproj" />
    <ProjectReference Include="..\PgLootMaster.Solver\PgLootMaster.Solver.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- App version. Displayed in the toolbar and stamped into the assembly. Bump this
         before cutting a release; publish.ps1 will also inject the version from -Release
         so the shipped exe always matches the git tag. -->
    <Version>1.4.2</Version>
    <!-- Ship only the English satellite (resources) — every other language pack is dead
         weight for this Windows-only English app. This alone shaves ~15-25 MB off the
         single-file exe (WPF, .NET base, OpenCvSharp all ship 20+ localised resource
         DLLs). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
