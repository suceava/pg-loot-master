<Window x:Class="PgLootMaster.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PG Loot Master"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="OnDragMouseDown">
    <Border Background="#E0202020"
            BorderBrush="#FF20FF20"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8,6">
        <StackPanel Orientation="Vertical">
            <!-- Row 1: title + controls -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="PG Loot Master"
                           Foreground="White"
                           FontFamily="Consolas"
                           FontSize="12"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="2,0,12,0" />
                <!-- Target dropdown moved to Settings window under the Solver section. -->
                <Button x:Name="SettingsButton"
                        Content="Settings"
                        Width="64" Height="24"
                        FontSize="11"
                        Margin="0,0,4,0"
                        Click="OnSettingsClick" />
                <Button x:Name="HistoryButton"
                        Content="History"
                        Width="64" Height="24"
                        FontSize="11"
                        Margin="0,0,4,0"
                        Click="OnHistoryClick" />
                <Button x:Name="LabelerDebugButton"
                        Content="Labeler"
                        Width="64" Height="24"
                        FontSize="11"
                        Margin="0,0,4,0"
                        Click="OnLabelerDebugClick" />
                <Button x:Name="CloseButton"
                        Content="Close"
                        Width="56" Height="24"
                        FontSize="11"
                        Background="#FF802020"
                        Foreground="White"
                        Click="OnCloseClick" />
            </StackPanel>

            <!-- Row 2: strategy + current state + per-strategy comparisons -->
            <Border BorderBrush="#FF333333"
                    BorderThickness="0,1,0,0"
                    Margin="0,8,0,0"
                    Padding="0,8,0,2">
                <StackPanel Orientation="Vertical">
                    <!-- Current state line: STRATEGY chip + turn + score -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="STRATEGY"
                                   Foreground="#FFAAAAAA"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="2,0,8,0" />
                        <Border Background="#FF20FF20"
                                CornerRadius="3"
                                Padding="8,3"
                                Margin="0,0,20,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StrategyChip"
                                       Foreground="#FF1E1E1E"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       FontWeight="Bold" />
                        </Border>
                        <TextBlock x:Name="LiveStateText"
                                   FontFamily="Consolas"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="LivePlaceholderText"
                                   Text="no active game"
                                   Foreground="#FF888888"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Target Hunter lock indicator (shown only under Target Hunter) -->
                    <TextBlock x:Name="TargetLockText"
                               FontFamily="Consolas"
                               FontSize="12"
                               Margin="2,4,0,0"
                               Visibility="Collapsed" />
                    <!-- Per-strategy comparison rows (visibility toggled per row when data exists) -->
                    <TextBlock x:Name="CompareSafeText"
                               FontFamily="Consolas"
                               FontSize="12"
                               Margin="2,4,0,0"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="CompareCascadeHunterText"
                               FontFamily="Consolas"
                               FontSize="12"
                               Margin="2,2,0,0"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="CompareSpeedText"
                               FontFamily="Consolas"
                               FontSize="12"
                               Margin="2,2,0,0"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="CompareTargetHunterText"
                               FontFamily="Consolas"
                               FontSize="12"
                               Margin="2,2,0,0"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="CompareEmpiricalText"
                               FontFamily="Consolas"
                               FontSize="12"
                               Margin="2,2,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
