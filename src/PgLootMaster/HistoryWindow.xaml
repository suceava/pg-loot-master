<Window x:Class="PgLootMaster.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PG Loot Master — History"
        WindowStyle="ToolWindow"
        Topmost="True"
        ShowInTaskbar="False"
        Width="940"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E"
        Foreground="White"
        FontFamily="Consolas">
    <Window.Resources>
        <Style x:Key="DarkHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF202020" />
            <Setter Property="Foreground" Value="#FF20FF20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#FF333333" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="RightCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LeftCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Close"
                    Width="80"
                    Height="26"
                    Click="OnCloseClick" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="AGGREGATES BY GAME / STRATEGY"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#FF20FF20"
                       Margin="0,0,0,6" />
            <Border Grid.Row="1"
                    BorderBrush="#FF20FF20"
                    BorderThickness="0,0,0,1"
                    Margin="0,0,0,6" />

            <DataGrid Grid.Row="2"
                      x:Name="AggregatesGrid"
                      AutoGenerateColumns="False"
                      Background="#FF2A2A2A"
                      Foreground="White"
                      RowBackground="#FF2A2A2A"
                      AlternatingRowBackground="#FF303030"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#FF333333"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      IsReadOnly="True"
                      ColumnHeaderStyle="{StaticResource DarkHeaderStyle}"
                      MaxHeight="240"
                      Margin="0,0,0,16">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Game"     Binding="{Binding Game}"          Width="110" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="Strategy" Binding="{Binding Strategy}"      Width="110" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="Games"    Binding="{Binding Games}"         Width="70"  ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Top"      Binding="{Binding TopScore}"      Width="80"  ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Avg"      Binding="{Binding AvgScore}"      Width="80"  ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Top/min"  Binding="{Binding TopPerMin}"     Width="80"  ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Avg/min"  Binding="{Binding AvgPerMin}"     Width="80"  ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Avg Turns" Binding="{Binding AvgTurns}"     Width="90"  ElementStyle="{StaticResource RightCell}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="3"
                       Text="RECENT GAMES  (Del to delete selected)"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#FF20FF20"
                       Margin="0,0,0,6" />

            <DataGrid Grid.Row="4"
                      x:Name="GamesGrid"
                      AutoGenerateColumns="False"
                      Background="#FF2A2A2A"
                      Foreground="White"
                      RowBackground="#FF2A2A2A"
                      AlternatingRowBackground="#FF303030"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#FF333333"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      ColumnHeaderStyle="{StaticResource DarkHeaderStyle}"
                      PreviewKeyDown="OnGamesGridKeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date"      Binding="{Binding DateText}"     Width="150" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="Game"      Binding="{Binding Game}"         Width="110" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="Strategy"  Binding="{Binding StrategyName}" Width="110" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="Score"     Binding="{Binding Score}"        Width="80"  ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Turns"     Binding="{Binding Turns}"        Width="70"  ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Score/min" Binding="{Binding ScorePerMin}"  Width="90"  ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Duration"  Binding="{Binding Duration}"     Width="100" ElementStyle="{StaticResource RightCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
