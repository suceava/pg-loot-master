<Window x:Class="PgLootMaster.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="PG Loot Master — History"
        WindowStyle="ToolWindow"
        Topmost="True"
        ShowInTaskbar="False"
        Width="980"
        Height="660"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E"
        Foreground="White"
        FontFamily="Consolas">
    <Window.Resources>
        <Style x:Key="DarkHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF202020" />
            <Setter Property="Foreground" Value="#FF20FF20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#FF333333" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="RightCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LeftCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Cell styles that highlight when the row has the best stat in this column.
             Used for the aggregates DataGrid only. -->
        <Style x:Key="TopBestCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="#FF2A2A2A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTopBest}" Value="True">
                    <Setter Property="Background" Value="#FF1F4220" />
                    <Setter Property="Foreground" Value="#FF20FF20" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AvgBestCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="#FF2A2A2A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAvgBest}" Value="True">
                    <Setter Property="Background" Value="#FF1F4220" />
                    <Setter Property="Foreground" Value="#FF20FF20" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TopPerMinBestCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="#FF2A2A2A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTopPerMinBest}" Value="True">
                    <Setter Property="Background" Value="#FF1F4220" />
                    <Setter Property="Foreground" Value="#FF20FF20" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AvgPerMinBestCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="#FF2A2A2A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAvgPerMinBest}" Value="True">
                    <Setter Property="Background" Value="#FF1F4220" />
                    <Setter Property="Foreground" Value="#FF20FF20" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AvgTurnsBestCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="#FF2A2A2A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAvgTurnsBest}" Value="True">
                    <Setter Property="Background" Value="#FF1F4220" />
                    <Setter Property="Foreground" Value="#FF20FF20" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="#FF2A2A2A" />
            <Setter Property="Foreground" Value="#FFCCCCCC" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderBrush" Value="#FF333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1E1E1E" />
                                <Setter Property="Foreground" Value="#FF20FF20" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Close"
                    Width="80"
                    Height="26"
                    Click="OnCloseClick" />
        </StackPanel>

        <TabControl Background="#FF1E1E1E"
                    BorderBrush="#FF333333"
                    BorderThickness="0,1,0,0">
            <!-- ============= Aggregates tab ============= -->
            <TabItem Header="AGGREGATES" Style="{StaticResource DarkTabItem}">
                <DataGrid x:Name="AggregatesGrid"
                          AutoGenerateColumns="False"
                          Background="#FF2A2A2A"
                          Foreground="White"
                          RowBackground="#FF2A2A2A"
                          AlternatingRowBackground="#FF303030"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#FF333333"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          IsReadOnly="True"
                          ColumnHeaderStyle="{StaticResource DarkHeaderStyle}"
                          Margin="0,12,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Game"      Binding="{Binding Game}"      Width="120" ElementStyle="{StaticResource LeftCell}" />
                        <DataGridTextColumn Header="Strategy"  Binding="{Binding Strategy}"  Width="120" ElementStyle="{StaticResource LeftCell}" />
                        <DataGridTextColumn Header="Games"     Binding="{Binding Games}"     Width="80"  ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Top"       Binding="{Binding TopScore}"  Width="90"  ElementStyle="{StaticResource RightCell}" CellStyle="{StaticResource TopBestCell}" />
                        <DataGridTextColumn Header="Avg"       Binding="{Binding AvgScore}"  Width="90"  ElementStyle="{StaticResource RightCell}" CellStyle="{StaticResource AvgBestCell}" />
                        <DataGridTextColumn Header="Top/min"   Binding="{Binding TopPerMin}" Width="90"  ElementStyle="{StaticResource RightCell}" CellStyle="{StaticResource TopPerMinBestCell}" />
                        <DataGridTextColumn Header="Avg/min"   Binding="{Binding AvgPerMin}" Width="90"  ElementStyle="{StaticResource RightCell}" CellStyle="{StaticResource AvgPerMinBestCell}" />
                        <DataGridTextColumn Header="Avg Turns" Binding="{Binding AvgTurns}"  Width="100" ElementStyle="{StaticResource RightCell}" CellStyle="{StaticResource AvgTurnsBestCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ============= Recent Games tab ============= -->
            <TabItem Header="RECENT GAMES" Style="{StaticResource DarkTabItem}">
                <DockPanel Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Del to delete selected"
                               Foreground="#FF888888"
                               FontSize="10"
                               Margin="0,0,0,6" />
                    <DataGrid x:Name="GamesGrid"
                              AutoGenerateColumns="False"
                              Background="#FF2A2A2A"
                              Foreground="White"
                              RowBackground="#FF2A2A2A"
                              AlternatingRowBackground="#FF303030"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#FF333333"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              ColumnHeaderStyle="{StaticResource DarkHeaderStyle}"
                              PreviewKeyDown="OnGamesGridKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date"      Binding="{Binding DateText}"     Width="150" ElementStyle="{StaticResource LeftCell}" />
                            <DataGridTextColumn Header="Game"      Binding="{Binding Game}"         Width="110" ElementStyle="{StaticResource LeftCell}" />
                            <DataGridTextColumn Header="Strategy"  Binding="{Binding StrategyName}" Width="110" ElementStyle="{StaticResource LeftCell}" />
                            <DataGridTextColumn Header="Score"     Binding="{Binding Score}"        Width="80"  ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="Turns"     Binding="{Binding Turns}"        Width="70"  ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="Score/min" Binding="{Binding ScorePerMin}"  Width="90"  ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="Duration"  Binding="{Binding Duration}"     Width="100" ElementStyle="{StaticResource RightCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============= Charts tab ============= -->
            <TabItem Header="CHARTS" Style="{StaticResource DarkTabItem}">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <TextBlock Text="Game:"
                                   Foreground="#FFAAAAAA"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox x:Name="ChartGameFilter"
                                  Width="160"
                                  Height="24"
                                  SelectionChanged="OnChartFilterChanged" />
                        <TextBlock Text="Show:"
                                   Foreground="#FFAAAAAA"
                                   VerticalAlignment="Center"
                                   Margin="16,0,6,0" />
                        <ComboBox x:Name="ChartModeFilter"
                                  Width="120"
                                  Height="24"
                                  SelectionChanged="OnChartFilterChanged">
                            <ComboBoxItem Content="Avg" IsSelected="True" />
                            <ComboBoxItem Content="Best game" />
                        </ComboBox>
                        <TextBlock x:Name="ChartSubtitle"
                                   Foreground="#FF888888"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="20,0,0,0" />
                    </StackPanel>
                    <oxy:PlotView x:Name="ScoreRatePlot"
                                  Background="#FF1E1E1E"
                                  Foreground="White" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
