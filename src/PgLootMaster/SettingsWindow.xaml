<Window x:Class="PgLootMaster.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PG Loot Master — Settings"
        WindowStyle="ToolWindow"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E"
        Foreground="White"
        FontFamily="Consolas">
    <StackPanel Margin="20">
        <TextBlock Text="DEBUG"
                   FontSize="11"
                   FontWeight="Bold"
                   Foreground="#FF20FF20"
                   Margin="0,0,0,8" />
        <Border BorderBrush="#FF20FF20"
                BorderThickness="0,0,0,1"
                Margin="0,0,0,12" />
        <CheckBox x:Name="ShowBoardOverlayCheckBox"
                  Content="Show board overlay (cell cluster borders)"
                  Foreground="White"
                  Margin="0,4"
                  Checked="OnShowBoardOverlayChanged"
                  Unchecked="OnShowBoardOverlayChanged" />
        <CheckBox x:Name="ShowDebugTextWindowCheckBox"
                  Content="Show debug text window (top-right status box)"
                  Foreground="White"
                  Margin="0,4"
                  Checked="OnShowDebugTextWindowChanged"
                  Unchecked="OnShowDebugTextWindowChanged" />
        <Button Content="Close"
                Width="80"
                Height="26"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Click="OnCloseClick" />
    </StackPanel>
</Window>
