<Window x:Class="PgLootMaster.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PG Loot Master — Settings"
        WindowStyle="ToolWindow"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E"
        Foreground="White"
        FontFamily="Consolas">
    <StackPanel Margin="20">
        <TextBlock Text="SOLVER"
                   FontSize="11"
                   FontWeight="Bold"
                   Foreground="#FF20FF20"
                   Margin="0,0,0,8" />
        <Border BorderBrush="#FF20FF20"
                BorderThickness="0,0,0,1"
                Margin="0,0,0,12" />
        <TextBlock Text="Strategy:"
                   Foreground="White"
                   Margin="0,0,0,4" />
        <ComboBox x:Name="StrategyComboBox"
                  Width="320"
                  Height="26"
                  FontSize="12"
                  HorizontalAlignment="Left"
                  SelectionChanged="OnStrategyChanged">
            <ComboBoxItem Content="Safe — favor immediate match, conservative" />
            <ComboBoxItem Content="Cascade Hunter — 2-turn lookahead, bet on chain reactions" />
            <ComboBoxItem Content="Speed — max score per turn, win fast" />
            <ComboBoxItem Content="Target Hunter — chase your selected sidebar item (experimental)" />
        </ComboBox>
        <TextBlock x:Name="StrategyDescription"
                   Foreground="#FFAAAAAA"
                   FontSize="10"
                   TextWrapping="Wrap"
                   Width="320"
                   Margin="0,6,0,0" />

        <!-- Target panel — only visible when Target Hunter strategy is selected. -->
        <StackPanel x:Name="TargetPanel"
                    Margin="0,12,0,0"
                    Visibility="Collapsed">
            <TextBlock Text="Target item:"
                       Foreground="White"
                       Margin="0,0,0,4" />
            <ComboBox x:Name="TargetComboBox"
                      Width="320"
                      Height="26"
                      FontSize="12"
                      HorizontalAlignment="Left"
                      SelectionChanged="OnTargetChanged" />
        </StackPanel>

        <TextBlock Text="DEBUG"
                   FontSize="11"
                   FontWeight="Bold"
                   Foreground="#FF20FF20"
                   Margin="0,16,0,8" />
        <Border BorderBrush="#FF20FF20"
                BorderThickness="0,0,0,1"
                Margin="0,0,0,12" />
        <CheckBox x:Name="ShowSwapHighlightCheckBox"
                  Content="Show swap tile highlight (pink border on suggested swap)"
                  Foreground="White"
                  Margin="0,4"
                  Checked="OnShowSwapHighlightChanged"
                  Unchecked="OnShowSwapHighlightChanged" />
        <CheckBox x:Name="ShowBoardOverlayCheckBox"
                  Content="Show board overlay (cell cluster borders)"
                  Foreground="White"
                  Margin="0,4"
                  Checked="OnShowBoardOverlayChanged"
                  Unchecked="OnShowBoardOverlayChanged" />
        <CheckBox x:Name="ShowDebugTextWindowCheckBox"
                  Content="Show debug text window (top-right status box)"
                  Foreground="White"
                  Margin="0,4"
                  Checked="OnShowDebugTextWindowChanged"
                  Unchecked="OnShowDebugTextWindowChanged" />
        <Button x:Name="RecomputeClustersButton"
                Content="Recompute clusters"
                Width="180"
                Height="26"
                HorizontalAlignment="Left"
                Margin="0,10,0,0"
                Click="OnRecomputeClustersClick" />
        <TextBlock Text="Forces a fresh canonical capture — use when item colors look mis-grouped."
                   Foreground="#FFAAAAAA"
                   FontSize="10"
                   TextWrapping="Wrap"
                   Width="320"
                   Margin="0,4,0,0" />

        <Button Content="Close"
                Width="80"
                Height="26"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Click="OnCloseClick" />
    </StackPanel>
</Window>
