<Window x:Class="PgLootMaster.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PG Loot Master Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        Left="-32000" Top="-32000" Width="1" Height="1">
    <Grid>
        <Border BorderBrush="Magenta" BorderThickness="3" />
        <Canvas IsHitTestVisible="False">
            <Border x:Name="PanelBorder"
                    BorderBrush="Lime"
                    BorderThickness="4"
                    Visibility="Collapsed" />
            <Canvas x:Name="CellCanvas" Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>
