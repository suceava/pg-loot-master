<Window x:Class="PgLootMaster.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PG Loot Master Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        Left="-32000" Top="-32000" Width="1" Height="1">
    <Grid>
        <Border BorderBrush="Magenta" BorderThickness="3" />
        <Canvas IsHitTestVisible="False">
            <Border x:Name="PanelBorder"
                    BorderBrush="Lime"
                    BorderThickness="4"
                    Visibility="Collapsed" />
            <Canvas x:Name="CellCanvas" Visibility="Collapsed" />
            <Canvas x:Name="SuggestionCanvas" Visibility="Collapsed" />
        </Canvas>
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Background="#E0000000"
                BorderBrush="#FF20FF20"
                BorderThickness="2"
                CornerRadius="4"
                Padding="14,10"
                IsHitTestVisible="False">
            <TextBlock x:Name="StatusText"
                       FontFamily="Consolas"
                       FontSize="14"
                       Foreground="White"
                       Text="Awaiting board..." />
        </Border>
    </Grid>
</Window>
