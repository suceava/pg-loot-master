<Window x:Class="PgLootMaster.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PG Loot Master Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        Left="-32000" Top="-32000" Width="1" Height="1">
    <Grid>
        <Canvas IsHitTestVisible="False">
            <Canvas x:Name="CellCanvas" Visibility="Collapsed" />
            <Canvas x:Name="SuggestionCanvas" Visibility="Collapsed" />
        </Canvas>
        <Border x:Name="StatusBorder"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Background="#E0000000"
                BorderBrush="#FF20FF20"
                BorderThickness="2"
                CornerRadius="4"
                Padding="14,10"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="StatusText"
                           FontFamily="Consolas"
                           FontSize="14"
                           Foreground="White"
                           Text="Awaiting board..." />
                <TextBlock Text="── last moves: tiles matched → score gained ──"
                           FontFamily="Consolas" FontSize="11" Foreground="#FF80FF80"
                           Margin="0,10,0,3" />
                <TextBlock x:Name="ScoringText"
                           FontFamily="Consolas" FontSize="13" Foreground="#FFFFE060"
                           Text="(no moves yet)" />
                <TextBlock Text="── clustering input (per-cell crops · number = cluster ID) ──"
                           FontFamily="Consolas" FontSize="11" Foreground="#FF80FF80"
                           Margin="0,10,0,3" />
                <Image x:Name="CropMontageImage" Width="480" Stretch="Uniform"
                       HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock Text="── OCR number reads (count-region crop · = parsed value) ──"
                           FontFamily="Consolas" FontSize="11" Foreground="#FF80FF80"
                           Margin="0,10,0,3" />
                <Image x:Name="NumbersMontageImage" Width="460" Stretch="Uniform"
                       HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
